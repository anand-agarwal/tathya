# Copy to .env.local. Never prefix secrets with VITE_ except the two public Supabase vars.

# Same hosted Supabase project as Bachpan (read-only anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq (OpenAI-compatible). Required for /api/chat.
# https://console.groq.com/keys — set the same vars on Vercel (Production + Preview).
GROQ_API_KEY=
# Optional default if the client does not send a model:
# GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: Firecrawl search (recommended).
# https://www.firecrawl.dev — do not prefix with VITE_.
# FIRECRAWL_API_KEY=fc-
